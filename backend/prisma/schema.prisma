// Prometeo — Esquema Prisma (PostgreSQL 16 + pgvector)
// Multi-tenant con RLS (app.current_tenant_id). Modelo de datos del SRS v1.0.0-PROD.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// ===== Identidad y Tenant =====

model Tenant {
  id                 String   @id @default(uuid()) @db.Uuid
  nombreComercial    String   @map("nombre_comercial")
  nit                String   @unique
  configuracionesJson Json?   @map("configuraciones_json") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at")

  users          User[]
  unspscProfiles UnspscProfile[]
  opportunities  Opportunity[]
  bids           Bid[]
  rfiRfps        RfiRfp[]
  analyses       Analysis[]
  milestones     ProjectMilestone[]
  contractDocuments ContractDocument[]
  contractProjects ContractProject[]
  financialLedgers FinancialLedger[]
  apiKeys        ApiKey[]
  aiConfigs      AiConfiguration[]
  documents      DocumentLibrary[]
  searchProfiles SearchProfile[]
  pliegoDocuments PliegoDocument[]
  notifications  NotificationLog[]
  adendaAlerts   AdendaAlert[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  email              String
  passwordHash       String    @map("password_hash")
  nombre             String
  rol                String // Admin | Evaluador Técnico | Evaluador Financiero | Operador de Proyecto | Auditor
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ===== Perfil UNSPSC del tenant =====

model UnspscProfile {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  codigoUnspsc String  @map("codigo_unspsc") @db.VarChar(8)
  descripcion String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("unspsc_profiles")
}

// ===== Oportunidades (espejo SECOP II / TVEC) =====

model Opportunity {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  secopId     String?  @map("secop_id")
  entidad     String?
  objeto      String?
  cuantiaCop  Decimal? @map("cuantia_cop") @db.Decimal(18, 2)
  fechaCierre DateTime? @map("fecha_cierre")
  estado      String   @default("disponible") // disponible | aplicada | descartada | borrada
  metadataJson Json?   @map("metadata_json") @db.JsonB
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bids   Bid[]
  analyses Analysis[]
  pliegoDocuments PliegoDocument[]
  adendaAlerts AdendaAlert[]

  @@index([tenantId, estado])
  @@index([secopId])
  @@map("opportunities")
}

// ===== Ofertas (Bids) — funnel =====

model Bid {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  opportunityId String?  @map("opportunity_id") @db.Uuid
  rfiRfpId      String?  @map("rfi_rfp_id") @db.Uuid
  faseFunnel    String   @default("borrador") @map("fase_funnel") // borrador | analisis | documental | firma | presentada
  valorOfertado Decimal? @map("valor_ofertado") @db.Decimal(18, 2)
  margenEstimado Decimal? @map("margen_estimado") @db.Decimal(5, 2)
  pWin          Decimal? @map("p_win") @db.Decimal(5, 2)
  documentoUrl  String?  @map("documento_url")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  rfiRfp    RfiRfp?  @relation(fields: [rfiRfpId], references: [id], onDelete: SetNull)
  analysis  Analysis?
  contractProjects ContractProject[]

  @@index([tenantId, faseFunnel])
  @@map("bids")
}

// ===== Proyectos ganados =====

model ContractProject {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  bidId        String   @map("bid_id") @db.Uuid
  numeroContrato String? @map("numero_contrato")
  fechaInicio  DateTime? @map("fecha_inicio")
  fechaFin     DateTime? @map("fecha_fin")
  valorTotal   Decimal? @map("valor_total") @db.Decimal(18, 2)
  estado       String   @default("activo")
  createdAt    DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bid    Bid     @relation(fields: [bidId], references: [id], onDelete: Cascade)
  ledgers FinancialLedger[]
  milestones ProjectMilestone[]
  documents ContractDocument[]

  @@index([tenantId])
  @@map("contract_projects")
}

// ===== Control financiero =====

model FinancialLedger {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  tipoMovimiento String  @map("tipo_movimiento") // ingreso | egreso
  concepto     String
  montoCop     Decimal  @map("monto_cop") @db.Decimal(18, 2)
  fechaRegistro DateTime @default(now()) @map("fecha_registro")

  tenant  Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project ContractProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("financial_ledgers")
}

// ===== API keys (patrón Fenix) =====

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyHash    String    @map("key_hash")
  prefix     String
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime? @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

// ===== Configuración de IA (Módulo 7) =====

model AiConfiguration {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  provider  String   // openrouter | openai | anthropic | ollama | deepseek
  model     String
  apiKeyRef String?  @map("api_key_ref") // referencia, no el valor
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ai_configurations")
}

// ===== Biblioteca maestra de documentos (Módulo 7) =====

model DocumentLibrary {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tipo       String   // rut | camara_comercio | cedula | estados_financieros | certificado
  nombre     String
  url        String
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("document_library")
}

// ===== Módulo 2: Invitaciones RFI/RFP =====

model RfiRfp {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  entidad       String
  emailOrigen   String?  @map("email_origen")
  asunto        String
  descripcion   String?  @db.Text
  fechaRecibido DateTime @default(now()) @map("fecha_recibido")
  fechaLimite   DateTime? @map("fecha_limite")
  estado        String   @default("recibida") // recibida | aplicada | rechazada | cotizada
  motivoRechazo String?  @map("motivo_rechazo")
  documentosUrl Json?    @map("documentos_url") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bids   Bid[]
  analyses Analysis[]

  @@index([tenantId, estado])
  @@map("rfi_rfp")
}

// ===== Módulo 3: Análisis IA (Go/No-Go) =====

model Analysis {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  opportunityId    String?  @map("opportunity_id") @db.Uuid
  rfiRfpId         String?  @map("rfi_rfp_id") @db.Uuid
  bidId            String?  @unique @map("bid_id") @db.Uuid
  requisitosJson   Json?    @map("requisitos_json") @db.JsonB
  financieroJson   Json?    @map("financiero_json") @db.JsonB
  costosJson       Json?    @map("costos_json") @db.JsonB
  pWin             Decimal? @map("p_win") @db.Decimal(5, 2)
  decision         String   @default("pendiente") // pendiente | go | nogo
  justificacion    String?  @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  rfiRfp      RfiRfp?      @relation(fields: [rfiRfpId], references: [id], onDelete: SetNull)
  bid         Bid?         @relation(fields: [bidId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("analyses")
}

// ===== Módulo 5: Hitos y entregables de proyectos =====

model ProjectMilestone {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  nombre    String
  fechaPrevista DateTime? @map("fecha_prevista")
  fechaReal DateTime? @map("fecha_real")
  estado    String   @default("pendiente") // pendiente | en_progreso | completado
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project ContractProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("project_milestones")
}

// ===== Módulo 5: Documentos contractuales (actas, informes) =====

model ContractDocument {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  tipo      String   // acta_inicio | acta_parcial | informe_supervision | acta_liquidacion
  nombre    String
  url       String
  fecha     DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project ContractProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([tenantId, projectId])
  @@map("contract_documents")
}

// ===== Benchmark Alicia: Perfiles de búsqueda (hasta 3 por tenant) =====

model SearchProfile {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nombre        String   // ej. "Línea SG-SST", "Equipo Energía"
  palabrasClave String?  @map("palabras_clave") @db.Text // búsqueda por keywords en objeto
  unspsc        Json?    @db.JsonB
  cuantiaMin    Decimal? @map("cuantia_min") @db.Decimal(18, 2)
  cuantiaMax    Decimal? @map("cuantia_max") @db.Decimal(18, 2)
  departamento  String?
  municipio     String?
  modalidad     String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("search_profiles")
}

// ===== RAG: Documentos de pliego (embeddings pgvector) =====

model PliegoDocument {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  opportunityId String?  @map("opportunity_id") @db.Uuid
  nombre        String
  url           String
  texto         String?  @db.Text
  embedding     Unsupported("vector(1536)")? // pgvector
  tamano        Int?
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("pliego_documents")
}

// ===== Notificaciones diarias (benchmark Alicia) =====

model NotificationLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tipo      String   // diaria | adenda | vencimiento
  asunto    String
  contenido String?  @db.Text
  enviadoA  String?  @map("enviado_a")
  enviado   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("notification_logs")
}

// ===== Monitor de adendas (Dif C: re-lectura automática de pliegos) =====

model AdendaAlert {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  opportunityId String?  @map("opportunity_id") @db.Uuid
  procesoId     String?  @map("proceso_id")
  fechaAnterior DateTime? @map("fecha_anterior")
  cambioDetectado Json?  @map("cambio_detectado") @db.JsonB
  notificada    Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  @@index([tenantId, notificada])
  @@map("adenda_alerts")
}
