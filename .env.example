# ===== Prometeo — Variables de entorno (producción) =====
# Copiar a .env en el VPS. NUNCA commitear .env real.

# --- PostgreSQL ---
POSTGRES_USER=prometeo
POSTGRES_PASSWORD=cambiar_por_secreto_fuerte
POSTGRES_DB=prometeo_main_db

# --- JWT / Auth ---
JWT_SECRET=cambiar_por_secreto_fuerte
JWT_EXPIRES_IN=7d

# --- Admin Hub (APP004) ---
NEXT_PUBLIC_ADMIN_API_URL=https://admin.cidesolutions.com/api
ADMIN_API_URL=https://admin.cidesolutions.com/api
ADMIN_API_KEY=cambiar_por_key_que_otorga_admin
ADMIN_APP_PRODUCT_CODE=APP004
LICENSE_SYNC_SECRET=cambiar_por_webhook_secret

# --- SODA API (Datos Abiertos SECOP II / TVEC) ---
SODA_APP_TOKEN=cambiar_por_app_token_socrata

# --- IA (OpenRouter) ---
OPENROUTER_API_KEY=cambiar_por_key_openrouter

# --- n8n ---
N8N_HOST=prometeo.cidesolutions.com
N8N_WEBHOOK_URL=https://prometeo.cidesolutions.com/webhook
N8N_ENCRYPTION_KEY=cambiar_por_clave_cifrado_n8n

# --- Rate limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
